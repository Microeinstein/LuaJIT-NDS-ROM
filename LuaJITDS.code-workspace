{
    "folders": [
        {"path": ".", "name": "project" },
        {"path": "foreign/luajit"},
        {"path": "/opt/devkitpro"},
        {"path": "/opt/blocksds"}
    ],
    "settings": {
        "Lua.workspace.ignoreSubmodules": true,
        "Lua.workspace.useGitIgnore": true,
        "Lua.diagnostics.libraryFiles": "Disable",
        "Lua.diagnostics.ignoredFiles": "Disable",
        "Lua.workspace.ignoreDir": [
            "trash",
            "foreign",
        ],
        // "clangd.arguments": [
        //     "-log=verbose", 
        //     "-pretty", 
        //     "--background-index", 
        //     // for cross compile usage
        //     // "--query-driver=/bin/arm-buildroot-linux-gnueabihf-g++",
        //     "--compile-commands-dir=."
        // ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "BUILD",
                "type": "process",
                "command": "bash",
                "args": ["build.sh"],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "BUILD_BL",
                "type": "process",
                "command": "bash",
                "args": ["build.blocksds.sh"],
                "group": {
                    "kind": "build",
                    "isDefault": true
                }
            },
            {
                "label": "MELON",
                "type": "process",
                "command": "melonDS",
                "args": ["out/test.nds"]
            }
        ]
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "gdb",
                "gdbpath": "/opt/devkitpro/devkitARM/bin/arm-none-eabi-gdb",
                "request": "attach",
                "name": "Attach ARM9",
                "autorun": ["interrupt"],
                "executable": "${workspaceFolder:project}/out/test.elf",
                "stopAtEntry": true,
                "target": ":3333",
                "remote": true,
                "cwd": "${workspaceFolder:project}",
                "valuesFormatting": "parseText"
            }
        ],
        "compounds": []
    },
}
